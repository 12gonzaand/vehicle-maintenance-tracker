<%- include('partials/header', { title: 'Settings' }) %>

<h1>Settings</h1>

<section class="section">
  <div class="section-header">
    <h2>Display</h2>
  </div>
  <p class="subtitle" style="margin: 0 0 0.9rem;">Choose how the manual reads on this device. System follows your OS.</p>
  <div class="theme-switch" role="radiogroup" aria-label="Theme">
    <button type="button" class="theme-option" data-theme-choice="light" role="radio" aria-checked="false">Light</button>
    <button type="button" class="theme-option" data-theme-choice="dark" role="radio" aria-checked="false">Dark</button>
    <button type="button" class="theme-option" data-theme-choice="system" role="radio" aria-checked="false">System</button>
  </div>
</section>

<section class="section">
  <div class="section-header">
    <h2>Header Name</h2>
  </div>
  <p class="subtitle" style="margin: 0 0 0.9rem;">What shows up top-left instead of "Maintenance Tracker" &mdash; just for your account.</p>
  <form method="post" action="/settings/display-name" class="form form-inline">
    <input type="text" name="display_name" maxlength="40" placeholder="Maintenance Tracker" value="<%= currentUser.display_name || '' %>">
    <button type="submit" class="btn">Save</button>
  </form>
</section>

<script src="/public/js/theme.js"></script>
<%- include('partials/footer') %>
