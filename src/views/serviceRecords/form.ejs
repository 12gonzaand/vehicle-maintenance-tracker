<%- include('../partials/header', { title: record ? 'Edit Service Record' : 'Add Service Record' }) %>

<p class="breadcrumb"><a href="/vehicles/<%= vehicle.id %>">&larr; <%= vehicle.name %></a></p>
<h1><%= record ? 'Edit Service Record' : 'Add Service Record' %></h1>

<form method="post" action="<%= record ? `/vehicles/${vehicle.id}/records/${record.id}` : `/vehicles/${vehicle.id}/records` %>" class="form"<% if (!record) { %> enctype="multipart/form-data"<% } %>>
  <% if (error) { %>
    <p class="form-error"><%= error %></p>
  <% } %>
  <% const knownNames = serviceTypes.map(st => st.name);
     const selectedKnown = record && record.serviceTypes ? record.serviceTypes.filter(n => knownNames.includes(n)) : [];
     const otherNames = record && record.serviceTypes ? record.serviceTypes.filter(n => !knownNames.includes(n)) : []; %>
  <div class="service-type-picker" data-service-type-picker data-selected='<%= JSON.stringify(selectedKnown) %>'>
    <label for="service-type-select">Service Type(s) — pick all that were performed on this bill</label>
    <select id="service-type-select" class="service-type-select">
      <option value="">+ Add a service type…</option>
      <% serviceTypes.forEach(st => { %>
        <option value="<%= st.name %>"><%= st.name %></option>
      <% }) %>
    </select>
    <div class="service-type-chips"></div>
  </div>
  <label>Other (not listed above — comma-separated if more than one)
    <input type="text" name="other_types" value="<%= otherNames.join(', ') %>">
  </label>
  <div class="form-row">
    <label>Date Performed
      <input type="date" name="service_date" required value="<%= record ? record.service_date : '' %>">
    </label>
    <label>Mileage
      <input type="number" name="mileage" value="<%= record && record.mileage != null ? record.mileage : '' %>">
    </label>
    <label>Cost
      <input type="number" step="0.01" name="cost" value="<%= record && record.cost != null ? record.cost : '' %>">
    </label>
  </div>
  <label>Shop / Location (optional, e.g. "self" or shop name)
    <input type="text" name="shop" value="<%= record ? record.shop || '' : '' %>">
  </label>
  <label>Notes
    <textarea name="notes" rows="4"><%= record ? record.notes || '' : '' %></textarea>
  </label>
  <% if (!record) { %>
  <label>Receipts / Invoice Photos (optional, JPG/PNG/PDF)
    <input type="file" id="service-receipt-files" name="files" accept="image/jpeg,image/png,application/pdf" multiple>
  </label>
  <div class="receipt-scan-row">
    <button type="button" class="btn btn-small" id="service-scan-btn" data-vehicle-id="<%= vehicle.id %>">Scan receipt to autofill</button>
    <span class="receipt-scan-status" id="service-scan-status"></span>
  </div>
  <% } %>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><%= record ? 'Save Changes' : 'Add Record' %></button>
    <a class="btn" href="<%= record ? `/vehicles/${vehicle.id}/records/${record.id}` : `/vehicles/${vehicle.id}` %>">Cancel</a>
  </div>
</form>

<script src="/public/js/service-type-picker.js"></script>
<% if (!record) { %>
<script src="/public/js/receipt-scan.js"></script>
<% } %>
<%- include('../partials/footer') %>
