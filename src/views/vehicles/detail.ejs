<%- include('../partials/header', { title: vehicle.name }) %>

<div class="vehicle-hero<%= vehicle.photo_path ? ' has-photo' : '' %>">
  <div class="vehicle-hero-media">
    <% if (vehicle.photo_path) { %>
      <img class="vehicle-hero-photo" src="/uploads/<%= vehicle.photo_path %>" alt="<%= vehicle.name %>">
      <div class="vehicle-hero-scrim"></div>
    <% } else { %>
      <div class="vehicle-hero-noimg"><%- include('../partials/car-icon') %></div>
    <% } %>

    <% if (vehicle.vin) { %>
      <div class="vin-plate">
        <span class="vin-label">VIN</span>
        <span class="vin-value"><%= vehicle.vin %></span>
      </div>
    <% } %>

    <div class="vehicle-hero-body">
      <h1><%= vehicle.name %><% if (vehicle.archived) { %> <span class="badge">archived</span><% } %></h1>
      <p class="subtitle"><%= [vehicle.year, vehicle.make, vehicle.model].filter(Boolean).join(' ') || 'No details recorded' %></p>
      <%- include('../partials/odometer', { mileage: vehicle.current_mileage }) %>
    </div>
  </div>

  <div class="vehicle-hero-actions">
    <a class="btn" href="/vehicles/<%= vehicle.id %>/edit">Edit</a>
    <% if (vehicle.archived) { %>
      <form method="post" action="/vehicles/<%= vehicle.id %>/unarchive" class="inline-form">
        <button type="submit" class="btn">Unarchive</button>
      </form>
    <% } else { %>
      <form method="post" action="/vehicles/<%= vehicle.id %>/archive" class="inline-form">
        <button type="submit" class="btn">Archive</button>
      </form>
    <% } %>
    <form method="post" action="/vehicles/<%= vehicle.id %>/delete" class="inline-form" onsubmit="return confirm('Permanently delete this vehicle and all its service records? This cannot be undone.');">
      <button type="submit" class="btn btn-danger">Delete</button>
    </form>
  </div>
</div>

<section class="section">
  <div class="section-header">
    <h2>Reminders</h2>
  </div>

  <% if (reminders.length === 0) { %>
    <p class="empty-state">No reminders set up yet.</p>
  <% } else { %>
  <div class="table-scroll">
  <table class="records-table reminders-table">
    <thead><tr><th>Type</th><th>Status</th><th>Detail</th><th></th></tr></thead>
    <tbody>
      <% reminders.forEach(r => {
        const parts = [];
        if (r.rule.interval_miles) {
          parts.push('Every ' + r.rule.interval_miles.toLocaleString() + ' mi' +
            (r.milesRemaining != null ? ' — ' + Math.abs(r.milesRemaining).toLocaleString() + ' mi ' + (r.milesRemaining >= 0 ? 'left' : 'over') : ''));
        }
        if (r.rule.interval_months) {
          parts.push('Every ' + r.rule.interval_months + ' mo' +
            (r.dueDate ? ' — due ' + r.dueDate + ' (' + Math.abs(r.daysRemaining) + 'd ' + (r.daysRemaining >= 0 ? 'left' : 'over') + ')' : ''));
        }
        if (!r.lastService) parts.push('no service record yet');
        const detail = parts.join(' · ');
      %>
        <tr>
          <td><%= r.rule.service_type %></td>
          <td>
            <span class="badge <%= r.overdue ? 'badge-overdue' : (r.dueSoon ? 'badge-due-soon' : (r.lastService ? 'badge-ok' : '')) %>">
              <%= r.overdue ? 'Overdue' : (r.dueSoon ? 'Due soon' : (r.lastService ? 'OK' : 'No baseline')) %>
            </span>
          </td>
          <td class="reminder-detail-cell"><%= detail %></td>
          <td>
            <form method="post" action="/vehicles/<%= vehicle.id %>/reminder-rules/<%= r.rule.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this reminder?');">
              <button type="submit" class="btn btn-danger btn-small">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>

  <form method="post" action="/vehicles/<%= vehicle.id %>/reminder-rules" class="form form-inline">
    <label>Service Type
      <select name="service_type" required>
        <% serviceTypes.forEach(st => { %>
          <option value="<%= st.name %>"><%= st.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Every (miles)
      <input type="number" name="interval_miles" min="1" placeholder="e.g. 5000">
    </label>
    <label>Every (months)
      <input type="number" name="interval_months" min="1" placeholder="e.g. 36">
    </label>
    <button type="submit" class="btn">Add Reminder</button>
  </form>
</section>

<section class="section">
  <div class="section-header">
    <h2>Service Records</h2>
    <a class="btn btn-primary" href="/vehicles/<%= vehicle.id %>/records/new">+ Add Service Record</a>
  </div>

  <form method="get" class="filter-form">
    <label>Sort by
      <select name="sortBy" onchange="this.form.submit()">
        <option value="service_date" <%= query.sortBy === 'service_date' || !query.sortBy ? 'selected' : '' %>>Date</option>
        <option value="mileage" <%= query.sortBy === 'mileage' ? 'selected' : '' %>>Mileage</option>
        <option value="service_type" <%= query.sortBy === 'service_type' ? 'selected' : '' %>>Service Type</option>
      </select>
    </label>
    <label>Order
      <select name="order" onchange="this.form.submit()">
        <option value="DESC" <%= query.order !== 'ASC' ? 'selected' : '' %>>Descending</option>
        <option value="ASC" <%= query.order === 'ASC' ? 'selected' : '' %>>Ascending</option>
      </select>
    </label>
    <label>Filter by Type
      <select name="serviceType" onchange="this.form.submit()">
        <option value="">All</option>
        <% serviceTypes.forEach(st => { %>
          <option value="<%= st.name %>" <%= query.serviceType === st.name ? 'selected' : '' %>><%= st.name %></option>
        <% }) %>
      </select>
    </label>
  </form>

  <% if (records.length === 0) { %>
    <p class="empty-state">No service records yet.</p>
  <% } else { %>
  <div class="table-scroll">
  <table class="records-table">
    <thead>
      <tr><th>Date</th><th>Type</th><th>Mileage</th><th>Cost</th><th>Shop</th></tr>
    </thead>
    <tbody>
      <% records.forEach(r => { %>
        <tr onclick="window.location='/vehicles/<%= vehicle.id %>/records/<%= r.id %>'" class="clickable-row">
          <td><%= r.service_date %></td>
          <td><%= r.service_type %></td>
          <td><%= r.mileage != null ? r.mileage.toLocaleString() : '—' %></td>
          <td><%= r.cost != null ? '$' + r.cost.toFixed(2) : '—' %></td>
          <td><%= r.shop || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</section>

<section class="section">
  <div class="section-header">
    <h2>Mileage History</h2>
  </div>

  <form method="post" action="/vehicles/<%= vehicle.id %>/mileage-logs" class="form form-inline">
    <label>Date
      <input type="date" name="log_date" required>
    </label>
    <label>Mileage
      <input type="number" name="mileage" required>
    </label>
    <label>Note (optional)
      <input type="text" name="note">
    </label>
    <button type="submit" class="btn">Log Mileage</button>
  </form>

  <% if (mileageHistory.length === 0) { %>
    <p class="empty-state">No mileage history yet.</p>
  <% } else { %>
  <div class="table-scroll">
  <table class="records-table">
    <thead><tr><th>Date</th><th>Mileage</th><th>Source</th></tr></thead>
    <tbody>
      <% mileageHistory.forEach(m => { %>
        <tr>
          <td><%= m.date %></td>
          <td><%= m.mileage.toLocaleString() %></td>
          <td><%= m.source === 'service' ? m.label : (m.label || 'Mileage log') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <canvas id="mileage-chart" height="120"
    data-points='<%= JSON.stringify(mileageHistory.map(m => ({ date: m.date, mileage: m.mileage }))) %>'></canvas>
  <% } %>
</section>

<section class="section">
  <div class="section-header">
    <h2>Fuel Log</h2>
  </div>

  <form method="post" action="/vehicles/<%= vehicle.id %>/fuel-logs" class="form form-inline">
    <div class="receipt-scan-row">
      <label>Receipt Photo (optional — used to autofill below, not saved)
        <input type="file" id="fuel-receipt-photo" accept="image/jpeg,image/png">
      </label>
      <button type="button" class="btn btn-small" id="fuel-scan-btn" data-vehicle-id="<%= vehicle.id %>">Scan receipt to autofill</button>
      <span class="receipt-scan-status" id="fuel-scan-status"></span>
    </div>
    <label>Date
      <input type="date" name="fill_date" required>
    </label>
    <label>Mileage
      <input type="number" name="mileage" required>
    </label>
    <label>Grade
      <select name="fuel_grade">
        <option value="Regular (87)">Regular (87)</option>
        <option value="Mid-Grade (89)">Mid-Grade (89)</option>
        <option value="Premium (91)">Premium (91)</option>
        <option value="Premium (93)">Premium (93)</option>
        <option value="Diesel">Diesel</option>
        <option value="E85">E85</option>
      </select>
    </label>
    <label>Gallons
      <input type="number" name="gallons" step="0.001" min="0" required>
    </label>
    <label>Cost
      <input type="number" name="cost" step="0.01" min="0">
    </label>
    <button type="submit" class="btn">Log Fill-Up</button>
  </form>

  <% if (fuelLogs.length === 0) { %>
    <p class="empty-state">No fuel log entries yet.</p>
  <% } else { %>
  <div class="table-scroll">
  <table class="records-table">
    <thead>
      <tr><th>Date</th><th>Mileage</th><th>Grade</th><th>Gallons</th><th>Cost</th><th>$/gal</th><th>MPG</th><th></th></tr>
    </thead>
    <tbody>
      <% fuelLogs.forEach(f => { %>
        <tr>
          <td><%= f.fill_date %></td>
          <td><%= f.mileage.toLocaleString() %></td>
          <td><%= f.fuel_grade || '—' %></td>
          <td><%= f.gallons.toFixed(3) %></td>
          <td><%= f.cost != null ? '$' + f.cost.toFixed(2) : '—' %></td>
          <td><%= f.cost != null && f.gallons > 0 ? '$' + (f.cost / f.gallons).toFixed(3) : '—' %></td>
          <td><%= f.mpg != null ? f.mpg.toFixed(1) : '—' %></td>
          <td>
            <form method="post" action="/vehicles/<%= vehicle.id %>/fuel-logs/<%= f.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this fuel log entry?');">
              <button type="submit" class="btn btn-danger btn-small">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <canvas id="fuel-efficiency-chart" height="160"
    data-points='<%= JSON.stringify(fuelLogs.map(f => ({ date: f.fill_date, mpg: f.mpg }))) %>'></canvas>
  <% } %>
</section>

<script src="/public/js/chart-utils.js"></script>
<script src="/public/js/mileage-chart.js"></script>
<script src="/public/js/fuel-efficiency-chart.js"></script>
<%- include('../partials/footer') %>
